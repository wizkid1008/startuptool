# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — it must never be committed.

# Supabase → Project Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL       Project URL, e.g. https://xxxx.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  "anon" / "public" (newer label: publishable)
#                                  Safe to expose to browsers. Only safe
#                                  because RLS is enabled — see 0001.
#   SUPABASE_SERVICE_ROLE_KEY      "service_role" (newer label: secret)
#                                  Bypasses ALL row-level security. Server-side
#                                  only. Never ship this to a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API keys. Billable.
ANTHROPIC_API_KEY=
